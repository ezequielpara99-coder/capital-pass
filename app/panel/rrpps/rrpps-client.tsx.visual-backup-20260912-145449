function Menu({
  label,
  href,
  active = false,
}: {
  label: string;
  href: string;
  active?: boolean;
}) {
  return (
    <Link
      href={href}
      className={`flex items-center gap-3 rounded-xl border px-4 py-3 text-sm transition ${
        active
          ? "border-fuchsia-400/20 bg-fuchsia-500/[0.10] text-white"
          : "border-transparent text-white/35 hover:bg-white/[0.035] hover:text-white/70"
      }`}
    >

      <span
        className={`h-1.5 w-1.5 rounded-full ${
          active
            ? "bg-fuchsia-400 shadow-[0_0_10px_rgba(232,121,249,.8)]"
            : "bg-white/20"
        }`}
      />

      {label}

    </Link>
  );
}

// =====================================================
// METRIC
// =====================================================

function Metric({
  title,
  value,
  detail,
  accent = false,
  warning = false,
}: {
  title: string;
  value: string;
  detail: string;
  accent?: boolean;
  warning?: boolean;
}) {
  return (
    <div
      className={`rounded-[22px] border p-5 ${
        warning
          ? "border-amber-400/15 bg-amber-400/[0.035]"
          : accent
            ? "border-fuchsia-400/20 bg-gradient-to-br from-fuchsia-500/[0.08] to-[#0d0912]"
            : "border-white/[0.07] bg-[#0d0912]"
      }`}
    >

      <p className="text-xs uppercase tracking-[0.12em] text-white/30">
        {title}
      </p>

      <p
        className={`mt-5 text-3xl font-semibold ${
          warning
            ? "text-amber-200"
            : accent
              ? "text-fuchsia-100"
              : ""
        }`}
      >
        {value}
      </p>

      <p className="mt-2 text-xs text-white/30">
        {detail}
      </p>

    </div>
  );
}

