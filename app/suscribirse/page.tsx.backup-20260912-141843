import Link from "next/link";
import { redirect } from "next/navigation";

import { createClient } from "../../lib/supabase/server";
import { createAdminClient } from "../../lib/supabase/admin";

type PlanRow = {
  id: string;
  code: string;
  name: string;
  description: string | null;
  price_minor: number;
  currency: string;
  billing_interval: string;
  active: boolean;
};

type SearchParams = Promise<{
  registro?: string;
  error?: string;
}>;

function formatMoney(
  amount: number,
  currency = "ARS"
) {
  return new Intl.NumberFormat(
    "es-AR",
    {
      style: "currency",
      currency,
      maximumFractionDigits: 0,
    }
  ).format(amount);
}

function cleanText(
  value: FormDataEntryValue | null
) {
  return String(
    value ?? ""
  ).trim();
}

function isValidEmail(
  email: string
) {
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(
    email
  );
}

async function createSignup(
  formData: FormData
) {
  "use server";

  const firstName =
    cleanText(
      formData.get(
        "first_name"
      )
    );

  const lastName =
    cleanText(
      formData.get(
        "last_name"
      )
    );

  const organizationName =
    cleanText(
      formData.get(
        "organization_name"
      )
    );

  const email =
    cleanText(
      formData.get(
        "email"
      )
    ).toLowerCase();

  const whatsapp =
    cleanText(
      formData.get(
        "whatsapp"
      )
    );

  const planId =
    cleanText(
      formData.get(
        "plan_id"
      )
    );

  if (
    !firstName ||
    !lastName ||
    !organizationName ||
    !email ||
    !planId
  ) {
    redirect(
      "/suscribirse?error=campos"
    );
  }

  if (
    !isValidEmail(
      email
    )
  ) {
    redirect(
      "/suscribirse?error=email"
    );
  }

  const admin =
    createAdminClient();

  // ==========================================================
  // VALIDAR PLAN
  // ==========================================================

  const {
    data: plan,
    error: planError,
  } = await admin
    .from(
      "subscription_plans"
    )
    .select(`
      id,
      active
    `)
    .eq(
      "id",
      planId
    )
    .eq(
      "active",
      true
    )
    .maybeSingle();

  if (
    planError ||
    !plan
  ) {
    console.error(
      "ERROR VALIDANDO PLAN:",
      planError
    );

    redirect(
      "/suscribirse?error=plan"
    );
  }

  // ==========================================================
  // EVITAR DUPLICADOS PENDIENTES
  // ==========================================================

  const {
    data: existingSignup,
    error: existingError,
  } = await admin
    .from(
      "subscription_signups"
    )
    .select(`
      id,
      status
    `)
    .eq(
      "email",
      email
    )
    .in(
      "status",
      [
        "pending",
        "payment_pending",
      ]
    )
    .order(
      "created_at",
      {
        ascending: false,
      }
    )
    .limit(1)
    .maybeSingle();

  if (
    existingError
  ) {
    console.error(
      "ERROR BUSCANDO SOLICITUD EXISTENTE:",
      existingError
    );

    redirect(
      "/suscribirse?error=guardar"
    );
  }

  if (
    existingSignup
  ) {
    const {
      error: updateError,
    } = await admin
      .from(
        "subscription_signups"
      )
      .update({
        plan_id:
          planId,

        first_name:
          firstName,

        last_name:
          lastName,

        organization_name:
          organizationName,

        whatsapp:
          whatsapp ||
          null,

        status:
          "pending",

        updated_at:
          new Date().toISOString(),
      })
      .eq(
        "id",
        existingSignup.id
      );

    if (
      updateError
    ) {
      console.error(
        "ERROR ACTUALIZANDO SOLICITUD:",
        updateError
      );

      redirect(
        "/suscribirse?error=guardar"
      );
    }

    redirect(
      "/suscribirse?registro=ok"
    );
  }

  // ==========================================================
  // CREAR SOLICITUD
  // ==========================================================

  const {
    error: insertError,
  } = await admin
    .from(
      "subscription_signups"
    )
    .insert({
      plan_id:
        planId,

      first_name:
        firstName,

      last_name:
        lastName,

      organization_name:
        organizationName,

      email,

      whatsapp:
        whatsapp ||
        null,

      status:
        "pending",

      provider:
        "mercado_pago",
    });

  if (
    insertError
  ) {
    console.error(
      "ERROR CREANDO SOLICITUD:",
      insertError
    );

    redirect(
      "/suscribirse?error=guardar"
    );
  }

  redirect(
    "/suscribirse?registro=ok"
  );
}

