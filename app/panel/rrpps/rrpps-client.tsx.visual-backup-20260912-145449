// =====================================================
// HELPERS
// =====================================================

function formatMoney(
  value: number
) {
  return new Intl.NumberFormat(
    "es-AR",
    {
      style: "currency",
      currency: "ARS",
      maximumFractionDigits: 0,
    }
  ).format(value);
}

function getInitials(
  firstName: string,
  lastName: string
) {
  return `${firstName.charAt(
    0
  )}${lastName.charAt(
    0
  )}`.toUpperCase();
}

function formatLocation(
  rrpp: RRPP
) {
  const parts = [
    rrpp.assignedCity,
    rrpp.assignedZone,
  ].filter(Boolean);

  if (
    parts.length > 0
  ) {
    return parts.join(
      " · "
    );
  }

  return "Sin zona asignada";
}

function normalizeText(
  value: string
) {
  return value
    .normalize("NFD")
    .replace(
      /[\u0300-\u036f]/g,
      ""
    )
    .toLocaleLowerCase(
      "es-AR"
    )
    .trim();
}