"use client";

import Link from "next/link";

import {
  CSSProperties,
  useEffect,
  useMemo,
  useState,
} from "react";

import SaleDetailModal from "./sale-detail-modal";

// ============================================================
// TYPES
// ============================================================

type SaleRow = {
  id: string;

  buyerName: string;

  buyerDni:
    | string
    | null;

  sellerName: string;

  channel: string;

  ticketType: string;

  quantity: number;

  total: number;

  status: string;

  createdAt: string;
};

type Props = {
  event: {
    id: string;
    name: string;
  };

  organizationName: string;

  initials: string;

  metrics: {
    sales: number;

    tickets: number;

    total: number;

    rrppSales: number;
  };

  sales: SaleRow[];
};

type Theme =
  | "dark"
  | "light";

// ============================================================
// COMPONENT
// ============================================================

export default function VentasPanel({
  event,
  organizationName,
  initials,
  metrics,
  sales,
}: Props) {
  const [
    theme,
    setTheme,
  ] =
    useState<Theme>(
      "dark"
    );

  const [
    search,
    setSearch,
  ] =
    useState("");

  const [
    channel,
    setChannel,
  ] =
    useState("all");

  const [
    selectedSaleId,
    setSelectedSaleId,
  ] =
    useState<
      string | null
    >(null);

  // ==========================================================
  // TEMA
  // ==========================================================

  useEffect(() => {
    const saved =
      localStorage.getItem(
        "capital-pass-theme"
      );

    if (
      saved === "dark" ||
      saved === "light"
    ) {
      setTheme(saved);
    }
  }, []);

  function toggleTheme() {
    const next =
      theme === "dark"
        ? "light"
        : "dark";

    setTheme(next);

    localStorage.setItem(
      "capital-pass-theme",
      next
    );
  }

  // ==========================================================
  // DETALLE DE VENTA
  // ==========================================================

  function openSaleDetail(
    saleId: string
  ) {
    setSelectedSaleId(
      saleId
    );
  }

  function closeSaleDetail() {
    setSelectedSaleId(
      null
    );
  }

  // ==========================================================
  // FILTROS
  // ==========================================================

  const filteredSales =
    useMemo(() => {
      const query =
        search
          .trim()
          .toLowerCase();

      return sales.filter(
        (sale) => {
          const matchesSearch =
            !query ||
            sale.buyerName
              .toLowerCase()
              .includes(
                query
              ) ||
            sale.buyerDni
              ?.toLowerCase()
              .includes(
                query
              ) ||
            sale.sellerName
              .toLowerCase()
              .includes(
                query
              ) ||
            sale.ticketType
              .toLowerCase()
              .includes(
                query
              );

          const matchesChannel =
            channel ===
              "all" ||
            sale.channel ===
              channel;

          return (
            matchesSearch &&
            matchesChannel
          );
        }
      );
    }, [
      sales,
      search,
      channel,
    ]);

  // ==========================================================
  // COLORES
  // ==========================================================

  const themeVars =
    (
      theme === "dark"
        ? {
            "--cp-bg":
              "#06080c",

            "--cp-sidebar":
              "#080b10",

            "--cp-panel":
              "#0a0e14",

            "--cp-text":
              "#ffffff",

            "--cp-muted":
              "rgba(255,255,255,.38)",

            "--cp-border":
              "rgba(255,255,255,.07)",

            "--cp-hover":
              "rgba(34,211,238,.045)",
          }
        : {
            "--cp-bg":
              "#f3f7f9",

            "--cp-sidebar":
              "#ffffff",

            "--cp-panel":
              "#ffffff",

            "--cp-text":
              "#172027",

            "--cp-muted":
              "rgba(23,32,39,.55)",

            "--cp-border":
              "rgba(23,32,39,.10)",

            "--cp-hover":
              "rgba(6,182,212,.065)",
          }
    ) as CSSProperties;

  // ==========================================================
  // RENDER
  // ==========================================================

  return (
    <>
      <main
        style={
          themeVars
        }
        className="min-h-screen bg-[var(--cp-bg)] text-[var(--cp-text)]"
      >

        <div className="flex min-h-screen">

          {/* ==================================================
              SIDEBAR
          ================================================== */}

          <aside className="hidden w-[255px] shrink-0 border-r border-[var(--cp-border)] bg-[var(--cp-sidebar)] lg:flex lg:flex-col">

            <div className="border-b border-[var(--cp-border)] px-6 py-6">

              <Link
                href="/panel"
                className="flex items-center gap-3"
              >

                <div className="flex h-11 w-11 items-center justify-center rounded-2xl border border-purple-400/30 bg-gradient-to-br from-violet-600/50 to-fuchsia-600/20 font-black text-white shadow-[0_0_25px_rgba(139,92,246,.08)]">
                  CP
                </div>

                <div>

                  <p className="font-semibold">
                    Capital Pass
                  </p>

                  <p className="text-xs text-[var(--cp-muted)]">
                    Event Management
                  </p>

                </div>

              </Link>

            </div>

            <nav className="flex-1 space-y-1.5 px-3 py-5">

              <MenuItem
                label="Inicio"
                href="/panel"
              />

              <MenuItem
                label="Mis eventos"
                href="/panel/evento"
              />

              <MenuItem
                label="RRPPs"
                href="/panel/rrpps"
              />

              <MenuItem
                label="Ventas"
                href="/panel?section=ventas"
                active
              />

              <MenuItem
                label="Venta en puerta"
                href="/panel/puerta"
              />

              <MenuItem
                label="Ingresos"
                href="/panel?section=ingresos"
              />

              <MenuItem
                label="Notificaciones"
                href="/panel?section=notificaciones"
              />

              <MenuItem
                label="Informes"
                href="/panel/informes"
              />

            </nav>

            <div className="border-t border-[var(--cp-border)] p-4">

              <div className="rounded-2xl border border-[var(--cp-border)] bg-[var(--cp-hover)] p-4">

                <p className="text-sm font-medium">
                  {
                    organizationName
                  }
                </p>

                <p className="mt-1 text-xs text-[var(--cp-muted)]">
                  Organizador
                </p>

              </div>

            </div>

          </aside>

          {/* ==================================================
              CONTENIDO
          ================================================== */}

          <section className="relative min-w-0 flex-1 overflow-hidden">

            {/* ================================================
                FONDO
            ================================================ */}

            <div className="pointer-events-none absolute inset-0 overflow-hidden">

              <div className="absolute right-[-170px] top-[-170px] h-[500px] w-[500px] rounded-full bg-cyan-500/[0.08] blur-[140px]" />

              <div className="absolute bottom-[-200px] left-[20%] h-[460px] w-[460px] rounded-full bg-blue-600/[0.07] blur-[150px]" />

            </div>

            {/* ================================================
                HEADER
            ================================================ */}

            <header className="relative z-20 flex min-h-[78px] items-center justify-between border-b border-[var(--cp-border)] bg-[var(--cp-bg)]/75 px-5 backdrop-blur-xl md:px-8">

              <div>

                <p className="text-xs uppercase tracking-[0.18em] text-cyan-400/70">
                  Gestión comercial
                </p>

                <h1 className="mt-1 text-lg font-medium">
                  Ventas ·{" "}
                  {
                    event.name
                  }
                </h1>

              </div>

              <div className="flex items-center gap-3">

                <button
                  type="button"
                  onClick={
                    toggleTheme
                  }
                  className="glow-btn glow-btn-dark flex h-10 w-10 items-center justify-center rounded-xl text-sm transition duration-200 hover:scale-[1.04]"
                >
                  <span className="glow-btn-content">
                    {theme ===
                    "dark"
                      ? "☀️"
                      : "🌙"}
                  </span>
                </button>

                <div className="flex h-10 w-10 items-center justify-center rounded-full border border-cyan-400/20 bg-cyan-500/[0.08] text-sm font-semibold text-cyan-100 shadow-[0_0_20px_rgba(34,211,238,.05)]">
                  {initials}
                </div>

              </div>

            </header>

            {/* ================================================
                CONTENT
            ================================================ */}

            <div className="relative z-10 mx-auto max-w-[1500px] px-5 py-7 md:px-8">

              {/* ==============================================
                  TITULO
              ============================================== */}

              <div>

                <p className="text-sm text-[var(--cp-muted)]">
                  Seguimiento del evento
                </p>

                <h2 className="mt-2 text-3xl font-semibold">
                  Ventas
                </h2>

                <p className="mt-2 text-sm text-[var(--cp-muted)]">
                  Todas las ventas confirmadas del evento.
                </p>

              </div>

              {/* ==============================================
                  MÉTRICAS
              ============================================== */}

              <section className="mt-7 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

                <MetricCard
                  title="Ventas"
                  value={String(
                    metrics.sales
                  )}
                  detail="operaciones confirmadas"
                />

                <MetricCard
                  title="Entradas"
                  value={String(
                    metrics.tickets
                  )}
                  detail="tickets vendidos"
                />

                <MetricCard
                  title="Total vendido"
                  value={formatMoney(
                    metrics.total
                  )}
                  detail="importe acumulado"
                  accent
                />

                <MetricCard
                  title="Ventas RRPP"
                  value={String(
                    metrics.rrppSales
                  )}
                  detail="operaciones por promotores"
                />

              </section>

              {/* ==============================================
                  FILTROS
              ============================================== */}

              <section className="mt-5 flex flex-col gap-3 rounded-[22px] border border-[var(--cp-border)] bg-[var(--cp-panel)] p-4 md:flex-row">

                <div className="relative flex-1">

                  <span className="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-sm text-cyan-300/40">
                    ⌕
                  </span>

                  <input
                    type="text"
                    value={
                      search
                    }
                    onChange={(
                      event
                    ) =>
                      setSearch(
                        event
                          .target
                          .value
                      )
                    }
                    placeholder="Buscar comprador, DNI, RRPP o tanda..."
                    className="h-12 w-full rounded-xl border border-[var(--cp-border)] bg-[var(--cp-hover)] pl-10 pr-4 text-sm outline-none transition placeholder:text-[var(--cp-muted)] focus:border-cyan-400/40 focus:shadow-[0_0_20px_rgba(34,211,238,.05)]"
                  />

                </div>

                <select
                  value={
                    channel
                  }
                  onChange={(
                    event
                  ) =>
                    setChannel(
                      event
                        .target
                        .value
                    )
                  }
                  className="h-12 rounded-xl border border-[var(--cp-border)] bg-[var(--cp-panel)] px-4 text-sm outline-none transition focus:border-cyan-400/40"
                >

                  <option value="all">
                    Todos los canales
                  </option>

                  <option value="rrpp">
                    RRPP
                  </option>

                  <option value="organizer">
                    Organizador
                  </option>

                  <option value="door">
                    Puerta
                  </option>

                </select>

              </section>

              {/* ==============================================
                  HISTORIAL
              ============================================== */}

              <section className="mt-5 overflow-hidden rounded-[24px] border border-[var(--cp-border)] bg-[var(--cp-panel)]">

                <div className="border-b border-[var(--cp-border)] px-6 py-5">

                  <div className="flex items-end justify-between gap-4">

                    <div>

                      <h3 className="font-semibold">
                        Historial de ventas
                      </h3>

                      <p className="mt-1 text-xs text-[var(--cp-muted)]">
                        {
                          filteredSales.length
                        }{" "}
                        resultados
                      </p>

                    </div>

                    <div className="hidden rounded-full border border-cyan-400/10 bg-cyan-400/[0.04] px-3 py-1.5 text-[11px] text-cyan-300/60 sm:block">
                      Seleccioná una venta para ver sus entradas
                    </div>

                  </div>

                </div>

                {filteredSales.length ===
                0 ? (

                  <div className="p-8 text-sm text-[var(--cp-muted)]">
                    No encontramos ventas con esos filtros.
                  </div>

                ) : (

                  <>

                    {/* ==========================================
                        DESKTOP
                    ========================================== */}

                    <div className="hidden overflow-x-auto md:block">

                      <table className="w-full text-left">

                        <thead className="border-b border-[var(--cp-border)] text-[11px] uppercase tracking-[0.12em] text-[var(--cp-muted)]">

                          <tr>

                            <th className="px-6 py-4 font-medium">
                              Comprador
                            </th>

                            <th className="px-6 py-4 font-medium">
                              Venta
                            </th>

                            <th className="px-6 py-4 font-medium">
                              Vendedor
                            </th>

                            <th className="px-6 py-4 font-medium">
                              Cant.
                            </th>

                            <th className="px-6 py-4 font-medium">
                              Total
                            </th>

                            <th className="px-6 py-4 font-medium">
                              Estado
                            </th>

                            <th className="px-6 py-4 font-medium">
                              Fecha
                            </th>

                            <th className="px-6 py-4 text-right font-medium">
                              Acción
                            </th>

                          </tr>

                        </thead>

                        <tbody className="divide-y divide-[var(--cp-border)]">

                          {filteredSales.map(
                            (
                              sale
                            ) => (

                              <tr
                                key={
                                  sale.id
                                }
                                className="transition duration-200 hover:bg-cyan-400/[0.025]"
                              >

                                {/* COMPRADOR */}

                                <td className="px-6 py-5">

                                  <p className="text-sm font-medium">
                                    {
                                      sale.buyerName
                                    }
                                  </p>

                                  <p className="mt-1 text-xs text-[var(--cp-muted)]">
                                    {sale.buyerDni
                                      ? `DNI ${sale.buyerDni}`
                                      : "Sin DNI"}
                                  </p>

                                </td>

                                {/* VENTA */}

                                <td className="px-6 py-5">

                                  <p className="text-sm">
                                    {
                                      sale.ticketType
                                    }
                                  </p>

                                  <p className="mt-1 text-xs text-[var(--cp-muted)]">
                                    {formatChannel(
                                      sale.channel
                                    )}
                                  </p>

                                </td>

                                {/* VENDEDOR */}

                                <td className="px-6 py-5 text-sm">
                                  {
                                    sale.sellerName
                                  }
                                </td>

                                {/* CANTIDAD */}

                                <td className="px-6 py-5 text-sm">
                                  {
                                    sale.quantity
                                  }
                                </td>

                                {/* TOTAL */}

                                <td className="px-6 py-5 text-sm font-semibold">
                                  {formatMoney(
                                    sale.total
                                  )}
                                </td>

                                {/* ESTADO */}

                                <td className="px-6 py-5">

                                  <span className="rounded-full border border-emerald-400/10 bg-emerald-400/[0.08] px-2.5 py-1 text-[11px] text-emerald-400">
                                    {formatStatus(
                                      sale.status
                                    )}
                                  </span>

                                </td>

                                {/* FECHA */}

                                <td className="px-6 py-5 text-xs text-[var(--cp-muted)]">
                                  {formatDate(
                                    sale.createdAt
                                  )}
                                </td>

                                {/* ACCIÓN */}

                                <td className="px-6 py-5 text-right">

                                  <button
                                    type="button"
                                    onClick={() =>
                                      openSaleDetail(
                                        sale.id
                                      )
                                    }
                                    className="inline-flex h-10 items-center justify-center rounded-xl border border-cyan-400/20 bg-cyan-400/[0.06] px-4 text-xs font-medium text-cyan-200 transition duration-200 hover:scale-[1.04] hover:border-cyan-300/35 hover:bg-cyan-400/[0.10] hover:shadow-[0_0_24px_rgba(34,211,238,.10)]"
                                  >
                                    Ver detalle
                                  </button>

                                </td>

                              </tr>

                            )
                          )}

                        </tbody>

                      </table>

                    </div>

                    {/* ==========================================
                        MOBILE
                    ========================================== */}

                    <div className="divide-y divide-[var(--cp-border)] md:hidden">

                      {filteredSales.map(
                        (
                          sale
                        ) => (

                          <div
                            key={
                              sale.id
                            }
                            className="p-5"
                          >

                            <div className="flex items-start justify-between gap-4">

                              <div className="min-w-0">

                                <p className="truncate font-medium">
                                  {
                                    sale.buyerName
                                  }
                                </p>

                                <p className="mt-1 text-xs text-[var(--cp-muted)]">
                                  {
                                    sale.ticketType
                                  }{" "}
                                  ·{" "}
                                  {
                                    sale.quantity
                                  }{" "}
                                  entrada
                                  {sale.quantity !==
                                  1
                                    ? "s"
                                    : ""}
                                </p>

                                {sale.buyerDni && (

                                  <p className="mt-1 text-xs text-[var(--cp-muted)]">
                                    DNI{" "}
                                    {
                                      sale.buyerDni
                                    }
                                  </p>

                                )}

                              </div>

                              <p className="shrink-0 font-semibold">
                                {formatMoney(
                                  sale.total
                                )}
                              </p>

                            </div>

                            <div className="mt-4 flex items-start justify-between gap-4">

                              <div>

                                <p className="text-xs text-[var(--cp-muted)]">
                                  {
                                    sale.sellerName
                                  }{" "}
                                  ·{" "}
                                  {formatChannel(
                                    sale.channel
                                  )}
                                </p>

                                <p className="mt-1 text-xs text-[var(--cp-muted)]">
                                  {formatDate(
                                    sale.createdAt
                                  )}
                                </p>

                              </div>

                              <span className="shrink-0 rounded-full border border-emerald-400/10 bg-emerald-400/[0.08] px-2.5 py-1 text-[11px] text-emerald-400">
                                Confirmada
                              </span>

                            </div>

                            <button
                              type="button"
                              onClick={() =>
                                openSaleDetail(
                                  sale.id
                                )
                              }
                              className="mt-4 inline-flex h-11 w-full items-center justify-center rounded-xl border border-cyan-400/20 bg-cyan-400/[0.06] px-4 text-sm font-medium text-cyan-200 transition duration-200 active:scale-[0.98]"
                            >
                              Ver detalle de la venta
                            </button>

                          </div>

                        )
                      )}

                    </div>

                  </>

                )}

              </section>

            </div>

          </section>

        </div>

      </main>

      {/* ======================================================
          MODAL DETALLE
      ====================================================== */}

      <SaleDetailModal
        open={
          selectedSaleId !==
          null
        }
        saleId={
          selectedSaleId
        }
        onClose={
          closeSaleDetail
        }
      />

    </>
  );
}

// ============================================================
// MENU
// ============================================================

function MenuItem({
  label,
  href,
  active = false,
}: {
  label: string;
  href: string;
  active?: boolean;
}) {
  return (
    <Link
      href={href}
      className={`flex items-center gap-3 rounded-xl border px-4 py-3 text-sm transition duration-200 ${
        active
          ? "border-cyan-400/20 bg-cyan-400/[0.07] text-[var(--cp-text)] shadow-[0_0_25px_rgba(34,211,238,.035)]"
          : "border-transparent text-[var(--cp-muted)] hover:bg-[var(--cp-hover)] hover:text-[var(--cp-text)]"
      }`}
    >

      <span
        className={`h-1.5 w-1.5 rounded-full ${
          active
            ? "bg-cyan-400 shadow-[0_0_8px_rgba(34,211,238,.85)]"
            : "bg-gray-500"
        }`}
      />

      {label}

    </Link>
  );
}

// ============================================================
// METRIC
// ============================================================

function MetricCard({
  title,
  value,
  detail,
  accent = false,
}: {
  title: string;
  value: string;
  detail: string;
  accent?: boolean;
}) {
  return (
    <div
      className={`rounded-[22px] border p-5 transition duration-300 hover:-translate-y-[2px] ${
        accent
          ? "border-cyan-400/20 bg-gradient-to-br from-cyan-500/[0.08] via-[var(--cp-panel)] to-blue-500/[0.03] shadow-[0_0_35px_rgba(34,211,238,.045)]"
          : "border-[var(--cp-border)] bg-[var(--cp-panel)]"
      }`}
    >

      <p className="text-xs uppercase tracking-[0.12em] text-[var(--cp-muted)]">
        {title}
      </p>

      <p
        className={`mt-5 text-3xl font-semibold ${
          accent
            ? "text-cyan-100"
            : ""
        }`}
      >
        {value}
      </p>

      <p className="mt-2 text-xs text-[var(--cp-muted)]">
        {detail}
      </p>

    </div>
  );
}

// ============================================================
// HELPERS
// ============================================================

function formatMoney(
  value: number
) {
  return new Intl.NumberFormat(
    "es-AR",
    {
      style:
        "currency",

      currency:
        "ARS",

      maximumFractionDigits:
        0,
    }
  ).format(
    value
  );
}

function formatChannel(
  channel: string
) {
  if (
    channel ===
    "rrpp"
  ) {
    return "RRPP";
  }

  if (
    channel ===
    "door"
  ) {
    return "Puerta";
  }

  return "Organizador";
}

function formatStatus(
  status: string
) {
  if (
    status ===
    "confirmed"
  ) {
    return "Confirmada";
  }

  return status;
}

function formatDate(
  value: string
) {
  return new Intl.DateTimeFormat(
    "es-AR",
    {
      day:
        "2-digit",

      month:
        "2-digit",

      year:
        "numeric",

      hour:
        "2-digit",

      minute:
        "2-digit",

      timeZone:
        "America/Argentina/Buenos_Aires",
    }
  ).format(
    new Date(
      value
    )
  );
}